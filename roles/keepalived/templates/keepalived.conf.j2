global_defs {
    router_id DNS_{{ inventory_hostname }}
}

vrrp_script check_pihole {
    script "{{ keepalived_check_script }}"
    interval 5
    timeout 3
    fall 2
    rise 2
}

vrrp_instance VI_DNS {
    state {{ 'MASTER' if dns_keepalived_priority | int >= 200 else 'BACKUP' }}

    interface {{ keepalived_interface }}

    virtual_router_id {{ keepalived_router_id }}

    priority {{ dns_keepalived_priority }}

    advert_int 1

    authentication {
        auth_type {{ keepalived_auth_type }}
        auth_pass {{ keepalived_auth_pass }}
    }

    virtual_ipaddress {
        {{ keepalived_vip }}/24
    }

    track_script {
        check_pihole
    }
}
